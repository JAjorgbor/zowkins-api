# Zowkins API environment variables
#
# Copy this file to `.env` and fill in real values:  cp .env.example .env
# Everything here is validated at startup by src/config/config.ts — the server
# refuses to boot if a required variable is missing.
# Never commit the real `.env` (it is git-ignored); keep this file in sync when
# you add or remove a variable.

# ---------- Runtime ----------
# development | production | test
NODE_ENV=development
# Optional, defaults to 5500
PORT=5500
# Public URL of this API, shown as the server in Swagger
BASE_URL=http://localhost:5500
# Frontend base URL, used to build links in emails
WEBSITE_URL=http://localhost:3000
# Optional. Number of reverse proxies in front of the API, used to read the client
# IP for rate limiting. Defaults to 1 on Render, 0 elsewhere. Check with GET /v1/test/ip.
TRUST_PROXY=

# ---------- Database ----------
# MongoDB connection string (Atlas or local, e.g. mongodb://127.0.0.1:27017/)
DATABASE_URL=mongodb+srv://USERNAME:PASSWORD@cluster0.example.mongodb.net/
DATABASE_NAME=zowkins

# ---------- Auth ----------
# Long random string. Generate one with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
# All of the below are optional and fall back to these defaults
JWT_ACCESS_EXPIRATION_MINUTES=30
JWT_REFRESH_EXPIRATION_DAYS=30
JWT_RESET_PASSWORD_EXPIRATION_MINUTES=10
JWT_VERIFY_EMAIL_EXPIRATION_MINUTES=10
# How long an email verification code (OTP) stays valid
JWT_VERIFY_OTP_EXPIRATION_MINUTES=10
JWT_UPDATE_EMAIL_EXPIRATION_MINUTES=10
# Validity of an admin team invite, in days
JWT_ACCEPT_INVITE_VALIDITY_DAYS=10

# ---------- File storage (Cloudflare R2) ----------
# Product images, quote attachments and avatars
R2_BUCKET=zowkins
R2_ACCESS_KEY=your-r2-access-key
R2_SECRET_KEY=your-r2-secret-key
R2_ENDPOINT=https://ACCOUNT_ID.r2.cloudflarestorage.com
# Public base URL files are served from
R2_PUBLIC_URL=https://cdn.example.com

# ---------- Email (SendPulse) ----------
# API credentials from the SendPulse dashboard (SMTP / API tab)
SMTP_CLIENT_ID=your-sendpulse-client-id
SMTP_CLIENT_SECRET=your-sendpulse-client-secret
# Sender identity shown to recipients
EMAIL_FROM_NAME=Zowkins
EMAIL_FROM_ADDRESS=no-reply@example.com

# ---------- Payments (Paystack) ----------
# Secret key: payment links and webhook signature checks.
# Use the test key (sk_test_...) outside production.
PAYSTACK_SECRET_KEY=sk_test_your_paystack_secret_key
